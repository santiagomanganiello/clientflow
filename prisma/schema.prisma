// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  POTENTIAL
  CONTACTED
  NEGOTIATION
  CLIENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
}

model User {
  id           String      @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  clients      Client[]
}

model Client {
  id        String      @id @default(uuid())
  name      String
  email     String       @unique
  phone     String?
  company   String?
  status    ClientStatus @default(POTENTIAL)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  followUps FollowUp[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, email])
  @@index([userId, status])
}

model Note {
  id        String      @id @default(uuid())
  body      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
}

model FollowUp {
  id          String      @id @default(uuid())
  description String
  dueAt       DateTime
  status      FollowUpStatus @default(PENDING)
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([clientId, dueAt])
}
