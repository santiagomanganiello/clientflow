{
  "name": "clientflow",
  "private": true,
  "version": "1.0.0",
  "description": "mini CRM para freelancers",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @clientflow/web dev",
    "dev:api": "pnpm --filter @clientflow/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @clientflow/api db:generate",
    "db:migrate": "pnpm --filter @clientflow/api db:migrate",
    "db:deploy": "pnpm --filter @clientflow/api db:deploy",
    "db:status": "pnpm --filter @clientflow/api db:status",
    "db:studio": "pnpm --filter @clientflow/api db:studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module"
}
